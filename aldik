class Car:
    def __init__(self, brand, model, year):
        self.brand = brand
        self.model = model
        self.year = year

    def get_age(self, current_year):
        return current_year - self.year

# Пример использования:
my_car = Car("Toyota", "Camry", 2018)
current_year = 2026
print(f"Автомобиль: {my_car.brand} {my_car.model}")
print(f"Возраст автомобиля: {my_car.get_age(current_year)} лет")

