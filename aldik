class Book:
    def __init__(self, title, author, pages):
        self.title = title
        self.author = author
        self.pages = pages

    def reading_time(self):
        # 1 страница = 2 минуты
        return self.pages * 2

# Пример использования:
my_book = Book("Мастер и Маргарита", "Михаил Булгаков", 400)
print(f"Книга: {my_book.title}, Автор: {my_book.author}")
print(f"Примерное время чтения: {my_book.reading_time()} минут")

