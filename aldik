1 и 2.  Person (с методом introduce)
Python
class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    def introduce(self):
        print(f"Меня зовут {self.name}, мне {self.age} лет")

# Создаем два объекта
person1 = Person("Алексей", 25)
person2 = Person("Мария", 30)

# Выводим их атрибуты
print(f"Объект 1: имя — {person1.name}, возраст — {person1.age}")
print(f"Объект 2: имя — {person2.name}, возраст — {person2.age}")

# Проверяем метод introduce
person1.introduce()
person2.introduce()

